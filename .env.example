# Local defaults work without any of these. Add keys to upgrade signal
# quality and question writing. The swarm degrades cleanly when a key
# or source is missing.

# sqlite:///./question_engine.db  (default) or a Render Postgres URL
DATABASE_URL=sqlite:///./question_engine.db

# Open by default (WO-005). Any value other than off turns the token gate on.
DASHBOARD_AUTH=off
DASHBOARD_TOKEN=
ACCESS_TOKEN=
MAX_RUNS_PER_DAY=5
RUN_COOLDOWN_SECONDS=600

# Claude. Without this key the swarm uses a grounded heuristic fallback.
# Volume model: scouts + smiths. Judgment model: cross-pollinator + curator.
# Do not economize on judgment — that is where question quality is decided.
ANTHROPIC_API_KEY=
# Required if the key is identity-linked / multi-workspace (wrkspc_…).
# Skip this if the key is scoped to a single workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5
JUDGMENT_MODEL=claude-fable-5
# Same prompt and schema, one retry. Never rewrite the prompt to get past a refusal.
FALLBACK_MODEL=claude-opus-5-5
RUN_BUDGET_USD=5.00
RUN_TOKEN_CAP=400000

# Optional. News/web breadth per vertical. Skipped when empty.
BRAVE_API_KEY=

# Reddit application-only OAuth. Without these the adapter errors instead of
# returning a silent zero.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SOURCE_DEAD_AFTER_RUNS=3

# Not used. CP 2026-09-08: no Perplexity. Primary docs first.
PERPLEXITY_API_KEY=

# Hard cap for one swarm run. Curator + archivist are reserved first.
DAILY_BUDGET_USD=2.00

# Bind for local `uvicorn`. Render injects PORT.
PORT=43417
